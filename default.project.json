{
	"globIgnorePaths": [
		"**/*.md"
	],
	"name": "ModuxV3",
	"tree": {
		"$className": "DataModel",
		"Lighting": {},
		"ReplicatedFirst": {},
		"ReplicatedStorage": {
			"shared": {
				"$className": "Folder",
				"$ignoreUnknownInstances": false,
				"Libs": {
					"$ignoreUnknownInstances": false,
					"$path": {
						"optional": "src/Libs"
					}
				},
				"Modux": {
					"$path": {
						"optional": "src/Modux/shared"
					}
				},
				"Types": {
					"$ignoreUnknownInstances": false,
					"$path": {
						"optional": "src/Shared/Types"
					}
				},
				"tablejs": {
					"$path": {
						"optional": "src/Shared/tablejs"
					}
				}
			}
		},
		"RobloxPluginGuiService": {},
		"ServerScriptService": {
			"server": {
				"$className": "Folder",
				"$ignoreUnknownInstances": false,
				"Modux": {
					"$path": {
						"optional": "src/Modux/server"
					}
				}
			}
		},
		"ServerStorage": {},
		"SoundService": {},
		"StarterGui": {},
		"StarterPack": {},
		"StarterPlayer": {
			"StarterCharacterScripts": {},
			"StarterPlayerScripts": {
				"client": {
					"$className": "Folder",
					"$ignoreUnknownInstances": false,
					"Modux": {
						"$path": {
							"optional": "src/Modux/client"
						}
					}
				}
			}
		},
		"Workspace": {}
	}
}